# NVIDIA AI Endpoints API key (required)
NVIDIA_API_KEY=your_nvidia_api_key

# Embedding model served via NVIDIA API
NVIDIA_EMBED_MODEL=nvidia/Nemotron-3-Embed-1B

# Generative LLM served via NVIDIA API
NVIDIA_LLM_MODEL=deepseek-ai/DeepSeek-R1-Distill-8B

# Vector DB
CHROMA_DB_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=unasucre_documents
CHROMA_PERSIST_DIRECTORY=data/chroma_db

# Retrieval tuning
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
RETRIEVAL_TOP_K=4

# Ingested source documents
RAW_PDFS_DIR=data/raw_pdfs

# Logging
LOG_LEVEL=INFO
